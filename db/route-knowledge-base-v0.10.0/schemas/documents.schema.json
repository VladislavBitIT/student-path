{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-engine.example/schemas/documents.schema.json",
  "title": "documents",
  "description": "Перечень документов. У каждого требования есть собственное подтверждение.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "requirement": {
        "enum": [
          "required",
          "conditional",
          "recommended"
        ]
      },
      "condition": {
        "$ref": "applicability.schema.json"
      },
      "form": {
        "enum": [
          "original",
          "copy",
          "certified_copy",
          "digital",
          "unspecified"
        ]
      },
      "copies": {
        "type": "integer",
        "minimum": 1
      },
      "instructions": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^SRC_[A-Z0-9_]+$"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "supports": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source_id",
            "locator",
            "supports"
          ],
          "additionalProperties": false
        },
        "minItems": 1
      }
    },
    "required": [
      "id",
      "title",
      "requirement",
      "form",
      "evidence"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "requirement": {
              "const": "conditional"
            }
          }
        },
        "then": {
          "required": [
            "condition"
          ]
        },
        "else": {
          "not": {
            "required": [
              "condition"
            ]
          }
        }
      }
    ]
  },
  "minItems": 0
}
