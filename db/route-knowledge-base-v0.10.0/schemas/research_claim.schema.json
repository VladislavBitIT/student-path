{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-engine.example/schemas/research_claim.schema.json",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "documented",
        "partial",
        "unknown",
        "not_applicable"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^SRC_[A-Z0-9_]+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "locator",
          "supports"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "unresolved_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^UNR_[A-Z0-9_]+$"
      },
      "minItems": 0
    }
  },
  "required": [
    "state",
    "text",
    "evidence",
    "unresolved_ids"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "documented"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "partial",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "unresolved_ids": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
