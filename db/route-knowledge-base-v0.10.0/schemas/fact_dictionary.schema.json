{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-engine.example/schemas/fact_dictionary.schema.json",
  "title": "fact_dictionary",
  "description": "Словарь полей пользовательского профиля и контекста события. null и неизвестные значения не хранятся: ключ отсутствует.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "const": "facts"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "string",
              "number",
              "integer",
              "boolean",
              "date",
              "date_time",
              "enum"
            ]
          },
          "dictionary_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "code",
          "label",
          "type"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "enum"
                }
              }
            },
            "then": {
              "required": [
                "dictionary_id"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "dictionary_id"
                ]
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "id",
    "entries"
  ],
  "additionalProperties": false
}
