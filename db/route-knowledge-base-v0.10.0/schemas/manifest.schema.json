{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-engine.example/schemas/manifest.schema.json",
  "title": "manifest",
  "description": "Манифест сборки. released требует отдельной проверки готовности; schema validation не удостоверяет правовую достоверность.",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "package_id": {
      "const": "route_knowledge_base"
    },
    "package_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "created_on": {
      "type": "string",
      "format": "date"
    },
    "content_status": {
      "enum": [
        "scaffold",
        "draft",
        "released"
      ]
    },
    "production_ready": {
      "type": "boolean"
    },
    "language": {
      "const": "ru"
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema_files": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
          },
          "schema": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
          }
        },
        "required": [
          "path",
          "schema"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "federal_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "universities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "config": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
          },
          "overlays": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+\\.json$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "config",
          "overlays",
          "steps"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "integration_contract_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0",
        "1.3.0",
        "1.4.0",
        "1.5.0"
      ]
    },
    "built_at": {
      "type": "string",
      "format": "date-time"
    },
    "information_checked_on": {
      "type": "string",
      "format": "date"
    },
    "supported_universities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UNIV_[A-Z0-9_]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "config": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
          },
          "content_status": {
            "enum": [
              "draft",
              "verified",
              "retired"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "config",
          "content_status"
        ],
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$"
            }
          }
        },
        "required": [
          "id",
          "purpose",
          "files"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "created_on",
    "content_status",
    "production_ready",
    "language",
    "schema_dialect",
    "schema_files",
    "resources",
    "federal_steps",
    "universities",
    "integration_contract_version"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "content_status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "production_ready": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "production_ready": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "required": [
          "built_at",
          "information_checked_on",
          "supported_universities",
          "components"
        ]
      }
    }
  ]
}
