{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://route-engine.example/schemas/applicability.schema.json",
  "title": "applicability",
  "description": "Декларативное условие: true/false/unknown. Без исполняемого кода. Типы фактов проверяет валидатор связей.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "always"
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "all",
            "any"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "applicability.schema.json"
          },
          "minItems": 1
        }
      },
      "required": [
        "op",
        "args"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "not"
        },
        "arg": {
          "$ref": "applicability.schema.json"
        }
      },
      "required": [
        "op",
        "arg"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "fact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "op",
        "fact",
        "value"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "enum": [
            "in",
            "not_in"
          ]
        },
        "fact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "op",
        "fact",
        "values"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "op": {
          "const": "exists"
        },
        "fact": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      },
      "required": [
        "op",
        "fact"
      ],
      "additionalProperties": false
    }
  ]
}
